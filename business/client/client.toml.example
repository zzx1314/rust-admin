# 机器狗设备客户端配置模板
#
# 复制为 client.toml 后按现场修改（client.toml 已被 .gitignore 忽略，避免密钥入库）：
#   cp client.toml.example client.toml
#   chmod 600 client.toml
#
# 优先级（高 → 低）：命令行 > 环境变量 > 本文件 > 内置默认值
# 生效结果用 `cargo run -- --print-config` 查看（敏感字段自动脱敏）。

[server]
# 业务服务 WebSocket 地址；REST 地址默认由它推导（ws→http / wss→https）
# 现场：业务服务部署在 192.168.41.246
url = "ws://192.168.41.246:3100"
# 设备编号（= 机器狗 SN）**不要写在这里**：客户端启动时自动读本体分区
#   hexdump -C /dev/mmcblk0p5 | sed -n '3s/.*|\(.*\)|.*/\1/p' | tr -d ' '
# 本文件里写 device_id 会被当成未知字段直接报错。
# 只有本地调试 / 一台机器跑多个模拟实例时才用 --device-id 或 ROBODOG_DEVICE_ID 覆盖。
# 设备密钥：推荐用环境变量，不要写明文
secret_env = "ROBODOG_DEVICE_SECRET"
# secret = "不推荐：明文写在这里"
# 心跳间隔（秒，最小 1）
heartbeat_secs = 10

[api]
# 业务服务 REST 基地址；留空由 server.url 推导
base = ""
username = "admin"
# 登录密码：推荐用环境变量
password_env = "ROBODOG_API_PASSWORD"
# password = "不推荐：明文写在这里"

[robot]
# 智航 Pro 本体地址；填 sim / none / off = 模拟模式（只回传进度，不驱动机器人）
# 留空 = 使用内置默认本体 192.168.234.234
host = "192.168.234.234"
# 本体地图文件服务端口（协议文档 §4，HTTP 12000）
file_port = 12000
# 本体地图文件服务基地址；留空按 host + file_port 推导
file_base = ""
# 本体地图根目录（4013 未返回时使用）
map_root = "/ota/alg_data/map"
# 5000 的 map_type/goal_type：off（默认，强制 1 = 2D 栅格，与协议文档示例一致）/
# auto（航段全「沿道路」且本体地图有 map.geojson 时用 3 路网）/ on（强制 3）
# road_network = "off"

[ai]
# 航点 AI 识别：路线里某个航点配了「AI 识别」动作时，客户端到点会调本机板端 Agent
# （背包 FastAPI，默认 127.0.0.1:8000），把检出回传业务平台写告警。
# 为什么在客户端做：业务平台在公网、Agent 只在内网，服务端连不到板端；
# 客户端与 Agent 同机，127.0.0.1 一定通。
agent_url = "http://127.0.0.1:8000"
# 没接背包的机器可以关掉（等价 --no-ai / ROBODOG_AI_ENABLED=0）；
# 开着也只在「到点且有 AI 动作」时才探测一次 Agent，连不上只打一条 WARN
enabled = true
# 板端存证根目录（Agent 把命中帧写在 <jobs_dir>/<计划ID>/pt<航点下标>/）。
# 检出告警的证据图从这里读；留空 = 自动探测（也会从板端 plan_hit.evidence 学到真实路径），
# 板子路径与默认不同时才需要钉死（等价 ROBODOG_AI_JOBS_DIR）
# jobs_dir = "/root/backpack_dashboard/backend/detect_jobs"

[mapping]
# 建图类型：outdoor / indoor
kind = "outdoor"
# 地图名；留空用 map-<时间戳>
name = ""
# 建图完成后是否回传中台
upload = true
# 地图归属园区（业务库 parks.id）；留空则用控制台绑定的园区
park_id = 3
# 回传地图名；留空用本体返回的目录名
ingest_name = ""
# 只执行一次建图后退出（等价 --map-only）
once = false
# 地图定时增量同步间隔（秒）：只补平台没有的图，不覆盖已有记录；0 = 关闭
# （等价 --map-sync-interval / --no-map-sync；upload = false 时强制为 0）
sync_interval_secs = 600

[simulation]
# 未接本体（或本体指标缺失）时的模拟值
battery = 86
signal = 4
position = "0.0, 0.0"
firmware = "Hermes_M_v0.3.2"

[log]
# 等价 RUST_LOG；RUST_LOG 设置后优先生效
filter = "robodog_device_client=info"
