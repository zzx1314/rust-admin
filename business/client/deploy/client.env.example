# 拷到 /etc/robodog/client.env 后 chmod 600；由 systemd EnvironmentFile 加载。
# 只有非空值才会覆盖配置文件/默认值（空值等于未设置）。

# 业务服务登录密码：建图回传中台 / 同步地图时使用，线上必须覆盖
ROBODOG_API_PASSWORD=admin123

# 业务服务登录账号（默认 admin）
# ROBODOG_API_USERNAME=admin

# 设备密钥（服务端目前只预留字段，不校验）
# ROBODOG_DEVICE_SECRET=

# 需要临时改现场参数时也可用环境变量（优先级高于 client.toml）
# ROBODOG_SERVER_URL=ws://192.168.41.246:3100
# ROBODOG_ROBOT=192.168.234.234
# ROBODOG_PARK_ID=3

# 设备编号默认自动读本体 SN 分区（/dev/mmcblk0p5，需 root）。以下两项只在
# 本地调试 / 分区布局不同的机型上用：
# ROBODOG_DEVICE_ID=RD-DEBUG-01
# ROBODOG_SN_PATH=/dev/mmcblk0p5

# ── 排障日志 ────────────────────────────────────────────────
# 任务类报文（5000/5001/4030/4031/4044…）的完整 JSON 默认就在 info 级别打出，
# 只有需要连会话/地图/周期推送的帧一起看时才打开下面两项（改完必须重启进程）。
# RUST_LOG=robodog_device_client=debug
# 整帧落盘：每帧一行 JSONL（send + recv，含 head + data），与日志级别无关；
# 文件不轮转，排障完毕请注释掉并清理。
# ROBODOG_FRAME_DUMP=/var/log/robodog/frames.jsonl
