# 现场配置：/etc/robodog/client.toml（chmod 600）
#
# 只有需要覆盖内置默认值时才写这里。内置默认值已经是现场值：
#   server.url   = ws://192.168.41.246:3100
#   robot.host   = 192.168.234.234
# 设备编号不在这里配：客户端启动时自动读本体 SN 分区（/dev/mmcblk0p5），
# 本文件里出现 device_id 会按未知字段报错。
#
# 优先级（高 → 低）：命令行 > 环境变量 > 本文件 > 内置默认值。
# 生效结果核对：robodog-device-client --config /etc/robodog/client.toml --print-config

[server]
url = "ws://192.168.41.246:3100"
# 密钥走环境变量（/etc/robodog/client.env）
secret_env = "ROBODOG_DEVICE_SECRET"
heartbeat_secs = 10

[api]
# 留空由 server.url 推导 → http://192.168.41.246:3100
base = ""
username = "admin"
password_env = "ROBODOG_API_PASSWORD"

[robot]
# 机器狗本体（智航 Pro 网关）；填 sim / none / off = 模拟模式
host = "192.168.234.234"
# 本体地图文件服务（地图回传时拉包）
file_port = 12000
file_base = ""
map_root = "/ota/alg_data/map"
# 设备型号：本体 1201 `type` 为空时用它上报中台台账（取不到就留空，中台显示空）
# model = "ZSL-2-Ultra"

[video]
# 实时视频回传（RTSP → FLV → 业务平台）。enabled 为 false 时忽略 video_start。
enabled = true
# 现场机器狗是 aarch64：需要自带 ffmpeg（`apt install ffmpeg` 或放静态二进制后写全路径）
ffmpeg = "ffmpeg"
transport = "tcp"
# auto = 探测硬件编码器（机器狗上通常是 h264_rkmpp，没有 libx264）
encoder = "auto"
fps = 15
bitrate = "1200k"
# 0 = 原始分辨率
width = 0

[mapping]
kind = "outdoor"
name = ""
# 建图完成后是否回传中台；园区归属默认用控制台绑定的园区
upload = true
# 留空则用控制台绑定的园区（推荐）；写这里会强制覆盖
# park_id = 3
ingest_name = ""
once = false

[simulation]
battery = 86
position = "0.0, 0.0"
firmware = "Hermes_M_v0.3.2"

[log]
filter = "robodog_device_client=info"
