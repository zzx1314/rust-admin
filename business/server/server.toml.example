# 业务平台配置样例：复制为 server.toml 后按需修改。
#
# 优先级：环境变量 > 本文件 > 内置默认值。
# 路径可以是绝对路径；相对路径按**本文件所在目录**解析，与启动时的工作目录无关。
# 密钥建议仍放环境变量（ROBODOG_JWT_SECRET / ROBODOG_SERVICE_TOKEN /
# ROBODOG_ZENTAI_PASSWORD），本文件只放地址类配置。
#
# 指定配置文件路径：ROBODOG_SERVER_CONFIG=/etc/robodog/server.toml
# 不指定时使用当前工作目录下的 server.toml；该文件不存在则只用环境变量。

# 服务端口（默认 3100）
port = 3100

# SQLite 文件（默认 data/robodog.db）
# database = "data/robodog.db"

# 前端构建产物目录（默认 ../web/dist）
# web_dist = "../web/dist"

# 仓库根目录 backend 的 SQLite，用于导入 dog_map 中的 ROS 地图
# backend_db = "../../backend/data/users.db"

# 建图回传的本地留档目录（默认 data/map_ingest）
# ingest_dir = "data/map_ingest"

# 巡检录像（航点「录像采集」/ 航段「全程录像」）落盘目录（默认 data/recordings）。
# 视频比图大得多，正式机建议指到大盘（如 /var/lib/robodog/recordings）。
# recording_dir = "data/recordings"
# 录像保留天数（默认 30，0 = 不自动清理）：超期的行 + 文件由计划扫描每分钟收掉。
# recording_keep_days = 30

# 航点拍照（路线动作「可见光拍照」）落盘目录（默认 data/photos）。
# 单张几百 KB，与录像分开存：照片是巡检报告的证据，通常留得更久。
# photo_dir = "data/photos"
# 照片保留天数（默认 90，0 = 不自动清理）。
# photo_keep_days = 90

# Token 有效期（小时，默认 24）
# jwt_ttl_hours = 24

# 设备心跳超时（秒，默认 90，最小 20）：超时无心跳的在线设备会被看门狗置为离线。
# 客户端默认 10s 一次心跳，这里留 9 倍窗口；调整客户端心跳间隔时同步调大。
# 环境变量：ROBODOG_DEVICE_TIMEOUT_SECS
# device_timeout_secs = 90

# 任务执行超时（秒，默认 120，最小 30）：`执行中` 的任务超过这个时长没有任何
# 进度上报，看门狗会把它置为「异常」并记一条事件。
# 客户端跑任务时每 5s 上报一次进度，所以这个值只影响「客户端已经不报了」的场景
# （重启、掉线、或平台没真正下发任务），避免任务永久卡在执行中。
# 环境变量：ROBODOG_TASK_TIMEOUT_SECS
# task_timeout_secs = 120

# 任务进度停滞（秒，默认 600，最小 120）：`执行中` 的任务进度数值超过这个时长
# 没有推进，看门狗同样置为「异常」。只靠 task_timeout_secs 抓不到这种卡法——
# 客户端没有执行上下文时仍会周期性上报「执行中」，updated_at 一直是新鲜的。
# 环境变量：ROBODOG_TASK_STUCK_SECS
# task_stuck_secs = 600

[zentai]
# 反向控制信道：业务平台部署在内网、中台无法连入时必需。
# 配好后本服务会主动拨入 中台的 /api/dogDevice/control-plane/ws，
# 由中台在这条连接上下发指令 / 任务 / 运行态查询。
ws_url = "ws://192.168.41.10:3000"

# 共享服务令牌，需与中台 APP_DOG__BUSINESS_API_TOKEN 完全一致。
# 更推荐用环境变量 ROBODOG_SERVICE_TOKEN 提供，避免密钥落到仓库里。
# service_token = "change-me"

# ---- 建图回传 / 设备台账同步（只需要地址 + 上面的共享令牌）----
# 有 service_token 时走中台内部接口 /api/dogInternal/*，不需要中台账号。
base_url = "http://192.168.41.10:3000"

# ---- 兼容模式：没有共享令牌时才需要中台账号（登录换 JWT）----
# 只配服务令牌时这两项可以完全删掉。
# username = "sysadmin"
# password = "change-me"

# 数据采集背包（板端 Agent）接入
#
# 板端 Agent 是 FastAPI（无 CORS），页面只跟业务平台同源的 /api/backpack/* 打交道，
# 由服务端转发；视频仍是**浏览器直连板端 mediamtx**（低延时），不经平台中继。
# 详见 docs/backpack-video-integration.md
[backpack]
# 平台 → 背包 Agent，例如 http://192.168.234.200:8000
# 环境变量：ROBODOG_BACKPACK_URL
# base_url = "http://192.168.234.200:8000"

# 浏览器 → mediamtx 的 WHEP 基址，例如 http://192.168.234.200:8889
# 不填时由 base_url / browser_url 推导（同主机、端口 8889），端口不是 8889 才需要显式配置。
# 环境变量：ROBODOG_BACKPACK_WEBRTC_URL
# webrtc_url = "http://192.168.234.200:8889"

# 浏览器 → 板端 Agent 的地址（**直连模式**）：平台在公网、背包在现场内网时用这个。
# 配了就优先于 base_url：业务服务不再代理，只把该地址下发给页面，
# 由浏览器直连 Agent（板端需开 CORS：AGENT_CORS_ORIGINS）。
# 环境变量：ROBODOG_BACKPACK_BROWSER_URL
# browser_url = "http://192.168.41.246:8000"

# 航点 AI 识别「谁去调板端 Agent」：auto（默认）/ client / server。
#   - server：服务端直连 Agent，要求上面配了 base_url（服务端与板端同网段）；
#   - client：由设备客户端代调（它与 Agent 同机，走 127.0.0.1:8000），正式环境用这个；
#   - auto：配了 base_url 就 server，否则 client。两条链路不会重复开窗。
# 环境变量：ROBODOG_POINT_AI
# point_ai = "auto"

# ── 多设备（多台背包共用一套平台）────────────────────────────────────────────
#
# **通常什么都不用配**：板端 relay 自动把本体 SN 当设备编号（推流 path 带设备维度），
# 平台按 relay 注册的房间自动发现设备，AI 走设备客户端隧道（客户端 `agent_hello`
# 已经带了设备号与 Agent 地址）。平台中继的 WHEP 是固定同源路径
# `/api/backpack/whep/<stream>/whep`，也不需要按设备配。
#
# 这一段只在下面两种情况才需要：
#   1. 想给下拉里的设备起个中文名（只写 id + label）；
#   2. 服务端/浏览器能直连板端 Agent（同网段部署），想省掉隧道那一跳。
#
# 设备编号字符集 ^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$（= 平台设备台账 / 板端 SN）。
# 没配 Agent 地址的设备**只能看视频、不能开 AI**（页面会明确说明），
# 绝不会回退到默认设备 —— 否则会把 AI 起在另一台狗身上。
# 环境变量（JSON 数组，优先于本文件）：ROBODOG_BACKPACK_DEVICES
# [[backpack.devices]]
# id = "0202222672400230"
# label = "2号巡检狗"
# 同网段部署才需要（不填就走隧道）：
# base_url = "http://192.168.41.247:8000"       # 服务端直连 Agent
# browser_url = "http://192.168.41.247:8000"    # 浏览器直连 Agent
# tunnel_device = "0202222672400230"            # 不填 = id

# 识别窗口时长上限（秒，默认 300 = 路线单点停留上限）。
# 窗口按「该点停留时长 + 8s」算，这条只是兜底；离开航点（stage 离开 patrol.point_*）
# 会立刻结束窗口，所以不需要靠它防误报。担心长停留期间误报可以压小，比如 30。
# 环境变量：ROBODOG_AI_WINDOW_MAX_SECS
# ai_window_max_secs = 300

# 企业微信群机器人告警推送
#
# 群里「添加群机器人」后拿到 webhook（https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx），
# 执行任务异常 / 设备故障时把告警推到群里。企业微信的硬约束（代码已处理）：
#   - 每个机器人 20 条/分钟           → 本地限流 18 条，超出排队
#   - markdown 正文 ≤ 4096 **字节**   → 自动按字节截断（中文 3 字节/字）
#   - markdown 不支持 @               → @所有人另发一条 text
#   - 只能发不能收                    → 消息里带平台链接，处理仍在控制台
#
# ⚠ webhook 地址本身就是凭据（无签名校验，谁拿到谁能往群里发消息）。
# 推荐**只**用环境变量 ROBODOG_WECOM_WEBHOOK 提供：写进本文件意味着密钥进 git，
# 启动时会打一条警告。
[wecom]
# 配置级总开关。与库里 notification 组的 wecom_alert_push / wecom_task_abnormal
# 是「与」关系：这边是"这套部署有没有这个通道"，那边是"这个班次推不推"。
# 环境变量：ROBODOG_WECOM_ENABLED
enabled = true

# 推送级别下限：严重 / 警告（默认）/ 提示
# 环境变量：ROBODOG_WECOM_MIN_LEVEL
# min_level = "警告"

# 严重级别是否额外 @所有人（会占双倍限流额度：一条 text + 一条 markdown）
# 环境变量：ROBODOG_WECOM_MENTION_ALL
# mention_all = false

# 控制台对外地址：拼告警消息里的「查看详情」链接，例如 http://39.107.55.13:3008
# 不填时消息不带链接（猜一个地址比不给更容易误导人）。
# 环境变量：ROBODOG_PUBLIC_URL
# （这一项是本文件的顶层键，不是 [wecom] 里的）
