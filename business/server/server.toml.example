# 业务平台配置样例：复制为 server.toml 后按需修改。
#
# 优先级：环境变量 > 本文件 > 内置默认值。
# 路径可以是绝对路径；相对路径按**本文件所在目录**解析，与启动时的工作目录无关。
# 密钥建议仍放环境变量（ROBODOG_JWT_SECRET / ROBODOG_SERVICE_TOKEN /
# ROBODOG_ZENTAI_PASSWORD），本文件只放地址类配置。
#
# 指定配置文件路径：ROBODOG_SERVER_CONFIG=/etc/robodog/server.toml
# 不指定时使用当前工作目录下的 server.toml；该文件不存在则只用环境变量。

# 服务端口（默认 3100）
port = 3100

# SQLite 文件（默认 data/robodog.db）
# database = "data/robodog.db"

# 前端构建产物目录（默认 ../web/dist）
# web_dist = "../web/dist"

# 仓库根目录 backend 的 SQLite，用于导入 dog_map 中的 ROS 地图
# backend_db = "../../backend/data/users.db"

# 建图回传的本地留档目录（默认 data/map_ingest）
# ingest_dir = "data/map_ingest"

# Token 有效期（小时，默认 24）
# jwt_ttl_hours = 24

# 设备心跳超时（秒，默认 90，最小 20）：超时无心跳的在线设备会被看门狗置为离线。
# 客户端默认 10s 一次心跳，这里留 9 倍窗口；调整客户端心跳间隔时同步调大。
# 环境变量：ROBODOG_DEVICE_TIMEOUT_SECS
# device_timeout_secs = 90

# 任务执行超时（秒，默认 120，最小 30）：`执行中` 的任务超过这个时长没有任何
# 进度上报，看门狗会把它置为「异常」并记一条事件。
# 客户端跑任务时每 5s 上报一次进度，所以这个值只影响「客户端已经不报了」的场景
# （重启、掉线、或平台没真正下发任务），避免任务永久卡在执行中。
# 环境变量：ROBODOG_TASK_TIMEOUT_SECS
# task_timeout_secs = 120

# 任务进度停滞（秒，默认 600，最小 120）：`执行中` 的任务进度数值超过这个时长
# 没有推进，看门狗同样置为「异常」。只靠 task_timeout_secs 抓不到这种卡法——
# 客户端没有执行上下文时仍会周期性上报「执行中」，updated_at 一直是新鲜的。
# 环境变量：ROBODOG_TASK_STUCK_SECS
# task_stuck_secs = 600

[zentai]
# 反向控制信道：业务平台部署在内网、中台无法连入时必需。
# 配好后本服务会主动拨入 中台的 /api/dogDevice/control-plane/ws，
# 由中台在这条连接上下发指令 / 任务 / 运行态查询。
ws_url = "ws://192.168.41.10:3000"

# 共享服务令牌，需与中台 APP_DOG__BUSINESS_API_TOKEN 完全一致。
# 更推荐用环境变量 ROBODOG_SERVICE_TOKEN 提供，避免密钥落到仓库里。
# service_token = "change-me"

# ---- 建图回传 / 设备台账同步（只需要地址 + 上面的共享令牌）----
# 有 service_token 时走中台内部接口 /api/dogInternal/*，不需要中台账号。
base_url = "http://192.168.41.10:3000"

# ---- 兼容模式：没有共享令牌时才需要中台账号（登录换 JWT）----
# 只配服务令牌时这两项可以完全删掉。
# username = "sysadmin"
# password = "change-me"
