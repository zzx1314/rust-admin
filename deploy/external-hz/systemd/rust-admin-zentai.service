[Unit]
Description=Rust Admin 中台 API + 管理前端 (x-rust :3005)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 工作目录必须是安装目录：config/config.toml 与 migrations/ 都按它解析
WorkingDirectory=/opt/hz/rust-admin/zentai
# APP_JWT_SECRET / APP_DOG__BUSINESS_API_TOKEN / APP_CONFIG_FILE / RUST_LOG
EnvironmentFile=/opt/hz/rust-admin/zentai.env
ExecStart=/opt/hz/rust-admin/zentai/x-rust
Restart=always
RestartSec=3
# 崩溃后无限重试。systemd 219（CentOS 7）的 StartLimit* 在 [Service] 段
# （229 之后才挪到 [Unit]，写成 StartLimitIntervalSec）
StartLimitInterval=0
StartLimitBurst=0
# 机器只有 3.6G 内存且还跑着别的服务，尽量别被 OOM killer 先挑中
OOMScoreAdjust=-500
LimitNOFILE=65535

# 收紧权限：ProtectSystem=full 只把 /usr /boot /etc 设成只读，
# /opt/hz/rust-admin 下的数据目录仍然可写
# （systemd 219 没有 ReadWritePaths，写了会报 Unknown lvalue）
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
