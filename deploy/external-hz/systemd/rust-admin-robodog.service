[Unit]
Description=RoboDog OPS 业务平台 + 设备网关 (:3100)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# server.toml 里的相对路径（data/、web、migrations）按配置文件所在目录解析
WorkingDirectory=/opt/hz/rust-admin/robodog
# ROBODOG_JWT_SECRET / ROBODOG_SERVICE_TOKEN / ROBODOG_SERVER_CONFIG / RUST_LOG
EnvironmentFile=/opt/hz/rust-admin/robodog.env
ExecStart=/opt/hz/rust-admin/robodog/robodog-ops-server
Restart=always
RestartSec=3
# 崩溃后无限重试（systemd 219 的 StartLimit* 在 [Service] 段）
StartLimitInterval=0
StartLimitBurst=0
OOMScoreAdjust=-500
# 设备 WebSocket 网关是主要入口，连接数上限给足
LimitNOFILE=65535

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
